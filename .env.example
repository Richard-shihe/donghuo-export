# IEC 登录 / API
IBAO_USERNAME=
IBAO_PASSWORD=
IBAO_LOGIN_URL=
IBAO_ORIGIN=

# 飞书 Bitable 操作应用（默认自建应用：读 bitable + 写记录）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 飞书多维表格定位（已带默认值，可不用填）
BITABLE_APP_TOKEN=Tz0XbQVzkaZuJasBwb8cRjkfnoe
BITABLE_TABLE_ID=tblvugnoJPS8GrpX

# 飞书通知专用应用（如果不填，私信回退使用上面的 FEISHU_APP_ID）
FEISHU_NOTIFY_APP_ID=
FEISHU_NOTIFY_APP_SECRET=

# 通知名单（用 union_id 最稳，on_ 前缀；逗号/空格分隔。留空 = 用脚本内置的 2 个默认 Union ID）
NOTIFY_USERS=
# NOTIFY_DISABLE_DEFAULT=1    # 打开=不推默认 2 人

# 群机器人 webhook（可选）
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# ===== 可选运行参数 =====
# DRY_RUN=1                     # 等价 --dry-run
# UPDATE_LIMIT=50               # 等价 --update-limit 50
# EXPORT_START=202601
# EXPORT_END=202612
# IEC_PAGE_SIZE=100
# BITABLE_PAGE_SIZE=500
# VERBOSE=1                     # 等价 -v / --verbose
# LOG_MATCH_FILE=match.csv      # 等价 --log-match match.csv

# ===== Certification 质保书三阶段（Certification/）=====
# 汇报人员 union_id（逗号分隔；质保书流程专用名单，未配置时回退 FEISHU_UNION_IDS）
CERT_NOTIFY_UNION_IDS=
